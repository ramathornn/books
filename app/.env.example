# ─── Core (required) ─────────────────────────────────────────────────────────
# The defaults below match the services in docker-compose.yml for local dev.
DATABASE_URL="postgresql://books:books@localhost:5432/books"
REDIS_URL="redis://localhost:6379"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-random-secret-here"
# NODE_ENV="production"   # set in production

# ─── Security keys (required in production) ──────────────────────────────────
# The app throws if a feature that needs one of these runs without it.
# TAX_SIN_KEY / ENCRYPTION_KEY MUST be exactly 64 hex chars: openssl rand -hex 32
TAX_SIN_KEY=""            # AES-256-GCM key encrypting SINs in the tax module
ENCRYPTION_KEY=""         # AES-256-GCM key encrypting stored bank-connection tokens
FILES_API_TOKEN=""        # bearer token (>=16 chars) for the headless file/banking API
AUDIT_API_KEY=""          # bearer token for GET /api/audit-snapshot
FX_REVAL_SECRET=""        # shared secret authorizing the FX-revaluation cron
PLAID_SYNC_SECRET=""      # shared secret authorizing the daily bank-sync cron

# ─── Payments — Stripe (optional) ────────────────────────────────────────────
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ─── Email (optional) ────────────────────────────────────────────────────────
# EMAIL_PROVIDER="mailgun"      # "mailgun" (default) or "resend"
# EMAIL_FROM="billing@your-domain.com"
# Mailgun:
# MAILGUN_API_KEY=""
# MAILGUN_DOMAIN=""
# MAILGUN_REGION="us"           # or "eu"
# Resend:
# RESEND_API_KEY=""

# ─── AI receipt OCR (optional) ───────────────────────────────────────────────
# ANTHROPIC_API_KEY=""          # enables "scan a receipt" OCR via Claude
# ANTHROPIC_BASE_URL=""         # optional: route OCR through a gateway/proxy (cost attribution, governance, regional routing). Unset = default Anthropic endpoint.

# ─── Bank feeds — Plaid (optional; CSV import works without it) ───────────────
# PLAID_CLIENT_ID=""
# PLAID_SECRET=""
# PLAID_ENV="sandbox"           # or "production"

# ─── File storage & misc (optional — sensible defaults) ──────────────────────
# UPLOAD_ROOT="./uploads"               # where uploaded files are stored on disk
# RECEIPTS_ROOT_FOLDER="Receipts"       # top-level folder receipts are filed under
# TAX_FILES_ROOT_FOLDER="Tax Slips"     # top-level folder tax artifacts are filed under
# SUBCONTRACTOR_ACCOUNT_NUMBER=""       # optional GL account # when seeding tax accounts

# ─── Seed / maintenance scripts (one-time) ───────────────────────────────────
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD="change-me"
# OLD_ADMIN_EMAIL=""                    # used by scripts/delete-old-admin.ts
