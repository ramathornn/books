  @@index([taxYear])
  @@map("cca_schedule_entries")
}

model FilingExport {
  id                 String    @id @default(uuid())
  kind               String // t5_return | t4a_return | gst34_worksheet
  taxYear            Int       @map("tax_year")
  format             String // xml | worksheet_pdf | slip_zip
  status             String    @default("staged") // staged | downloaded | submitted | superseded
  slipIds            String[]  @map("slip_ids")
  summaryId          String?   @map("summary_id")
  checksum           String // checksum of regenerated payload; payload itself NOT stored
  validationReport   Json      @map("validation_report") // zod + xmllint results
  transmitterRef     String?   @map("transmitter_ref")
  storedFileId       String?   @map("stored_file_id") // plain id; only for non-SIN artifacts (worksheet)
  generatedAt        DateTime  @default(now()) @map("generated_at")
  submittedAt        DateTime? @map("submitted_at")
  submittedReference String?   @map("submitted_reference")

  @@index([kind, taxYear])
  @@map("filing_exports")
}

/**
 * T1Return — a Canadian personal income-tax return (T1) for one filer/year.
 *
 * Scope v1: a MARRIED, full-year Alberta resident CCPC owner paid PERSONALLY via
 * the company's own T5 dividends. The app PREPARES & VERIFIES the return; it can
 * NEVER NETFILE — there is no "filed" status (draft | prepared | superseded only).
 *
 * Design posture (mirrors TaxSlip / FilingExport):
 *  - One effective return per (taxYear, partyId); amendments are NEW rows in an
 *    amendsId chain with amendmentSeq+1 (prior -> "superseded").
 *  - lines/linesOverride are JSON keyed by CRA line number (effective value =
 *    linesOverride[k] ?? lines[k]).
 *  - NO SIN-bearing artifact persisted beyond the AES-GCM ciphers; the export is
 *    regenerated in memory on authorized download. Only checksum + validation
 *    report + line snapshot are stored (resultSnapshot).
 *  - engineVersion = "{computeSemver}+{rateYear}+{provHash}"; reopening a prepared
 *    return whose recomputed engineVersion differs forces an explicit re-prepare.
 */
model T1Return {
  id           String  @id @default(uuid())
  taxYear      Int     @map("tax_year")
  province     String  @default("AB") // filer's province of residence on Dec 31; NEVER inherited from CompanySettings
  status       String  @default("draft") // draft | prepared | superseded (NEVER "filed")
  amendmentSeq Int     @default(0) @map("amendment_seq") // T1-ADJ chain
  amendsId     String? @map("amends_id")
  amends       T1Return?  @relation("T1Amendment", fields: [amendsId], references: [id])
  amendedBy    T1Return[] @relation("T1Amendment")

  partyId String   @map("party_id") // filer (TaxParty, kind=individual)
  party   TaxParty @relation(fields: [partyId], references: [id])

  // Identity frozen at prepare (reuse buildRecipientSnapshot); NO live SIN persisted beyond cipher.
  taxpayerNameSnapshot    String    @default("") @map("taxpayer_name_snapshot")
  taxpayerSinCipher       String?   @map("taxpayer_sin_cipher")
  taxpayerAddressSnapshot String    @default("") @map("taxpayer_address_snapshot")
  taxpayerDobSnapshot     DateTime? @map("taxpayer_dob_snapshot") @db.Date // drives age amount + identification jacket

  // Marital status (v1 supports married/common-law; required spouse fields below when married).
  maritalStatus           String    @default("single") @map("marital_status") // single | married | commonLaw | separated | divorced | widowed
  spouseFirstNameSnapshot String?   @map("spouse_first_name_snapshot")
  spouseSinCipher         String?   @map("spouse_sin_cipher") // AES-GCM (iv:tag:ct); masked in UI, full only in in-memory export
  spouseNetIncome         Decimal?  @map("spouse_net_income") @db.Decimal(14, 2) // her line 23600; REQUIRED when married/common-law

  lines         Json  @default("{}") // engine-computed: CRA lineNumber (string) -> number
  linesOverride Json? @map("lines_override") // manual entry/override: lineNumber -> number
  pulledRefs    Json? @map("pulled_refs") // provenance + drift: lineNumber -> { slipNumber, amendmentSeq, slipIds[], total }

  resultSnapshot Json?  @map("result_snapshot") // frozen T1Result at prepare time
  engineVersion  String @default("") @map("engine_version") // {computeSemver}+{rateYear}+{provHash}

  preparedAt  DateTime? @map("prepared_at")
  notes       String    @default("")
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([taxYear, partyId, amendmentSeq])
  @@index([taxYear])
  @@index([partyId])
  @@index([status])
  @@index([amendsId])
  @@map("t1_returns")
}

/**
 * T2Return — a federal corporate income-tax return (T2) for one fiscal year.
 *
 * Scope v1 (locked persona): an owner-managed CCPC, Alberta-resident, DECEMBER-31
 * fiscal year-end, FULL 12-month years only, ACTIVE business income only, single
 * shareholder, paid via the corporation's OWN dividends. The app PREPARES &
 * VERIFIES the return; it can NEVER transmit (no CRA Corporation Internet Filing).
 * There is no "filed" status (draft | prepared | superseded only).
 *
 * The filer is THE COMPANY, so the natural key is (fiscalYearEnd, amendmentSeq) —
 * NOT (taxYear, partyId) like T1Return. The fiscalYearStart/End pair is the GL
 * window; taxationYear (calendar year the FYE falls in) is the rate-lookup key;
 * daysInYear is the EXPLICIT day count (365/366 normally; <365 short years are
 * gated OUT in v1 with a verify ERROR).
 *
 * lines/linesOverride are JSON keyed "form:line" (e.g. "S1:300", "S8:217",
 * "S3:460", "GIFI:2599"); effective value = linesOverride[k] ?? lines[k].
 * engineVersion = "{computeSemver}+{rateYear}+{fedHash}+{abHash}+{acciiYear}";
 * reopening a prepared return whose recomputed engineVersion differs forces an
 * explicit re-prepare. Only checksum + report + resultSnapshot persist — the
 * PII-bearing (Schedule 50 SIN) export is regenerated in memory on download.
 */
model T2Return {
  id              String   @id @default(uuid())
  fiscalYearStart DateTime @map("fiscal_year_start") @db.Date // GL-window start
  fiscalYearEnd   DateTime @map("fiscal_year_end") @db.Date // drives rate-year selection
  taxationYear    Int      @map("taxation_year") // calendar year the FYE falls in (rate key)
  daysInYear      Int      @default(365) @map("days_in_year") // EXPLICIT; <365 = short year (gated v1)

  status       String  @default("draft") // draft | prepared | superseded (NEVER "filed")
  amendmentSeq Int     @default(0) @map("amendment_seq")
  amendsId     String? @map("amends_id")
  amends       T2Return?  @relation("T2Amendment", fields: [amendsId], references: [id])
  amendedBy    T2Return[] @relation("T2Amendment")

  // Frozen corporate identity snapshot at prepare.
  legalNameSnapshot String @default("") @map("legal_name_snapshot")
  bnRcSnapshot      String @default("") @map("bn_rc_snapshot") // 9-digit BN + RC0001 program account
  provinceSnapshot  String @default("AB") @map("province_snapshot")

  // JSON line storage — keyed "form:line". effective = linesOverride[k] ?? lines[k].
  lines         Json  @default("{}")
  linesOverride Json? @map("lines_override")
  pulledRefs    Json? @map("pulled_refs") // "form:line" -> { source:'GL'|'CCA'|'JE'|'T5', ids[], total }

  // Schedule 141 attestations (enums/booleans, not amounts) live here, not in lines.
  s141 Json? // { involvement, gaapFramework, notesAttached }

  // First-year / judgement inputs confirmed via checkbox (PSB flag, taxable
  // capital, opening continuity confirmation) live in lines/linesOverride + the
  // T2ContinuityBalance record; no dedicated columns needed for v1.

  resultSnapshot Json?   @map("result_snapshot") // frozen { federal:T2Result, alberta:AT1Result } at prepare
  engineVersion  String  @default("") @map("engine_version") // {semver}+{rateYear}+{fedHash}+{abHash}+{acciiYear}
  preparedAt     DateTime? @map("prepared_at")
  notes          String  @default("")
  createdById    String? @map("created_by_id")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([fiscalYearEnd, amendmentSeq])
  @@index([taxationYear])
  @@index([status])
  @@index([amendsId])
  @@map("t2_returns")
}

/**
 * AT1Return — the Alberta corporate-tax return (AT1), a SIBLING of T2Return so a
 * federal reassessment and an Alberta reassessment version + amend INDEPENDENTLY.
 *
 * Alberta is outside the federal-provincial tax-collection agreement, so the
 * federal T2 carries NO Alberta line; Alberta tax is computed here and the user
 * re-keys it into Alberta TRA Net File separately. lines keyed by AT1 line number
 * (e.g. "AT1:070", "AT1:129"). engineVersion folds abHash + acciiYear.
 */
model AT1Return {
  id              String   @id @default(uuid())
  fiscalYearStart DateTime @map("fiscal_year_start") @db.Date
  fiscalYearEnd   DateTime @map("fiscal_year_end") @db.Date
  taxationYear    Int      @map("taxation_year")
  daysInYear      Int      @default(365) @map("days_in_year")

  status       String  @default("draft") // draft | prepared | superseded
  amendmentSeq Int     @default(0) @map("amendment_seq")
  amendsId     String? @map("amends_id")
  amends       AT1Return?  @relation("AT1Amendment", fields: [amendsId], references: [id])
  amendedBy    AT1Return[] @relation("AT1Amendment")

  legalNameSnapshot       String @default("") @map("legal_name_snapshot")
  albertaCanSnapshot      String @default("") @map("alberta_can_snapshot") // 10-digit Alberta CAN
  provinceSnapshot        String @default("AB") @map("province_snapshot")

  lines         Json  @default("{}")
  linesOverride Json? @map("lines_override")
  pulledRefs    Json? @map("pulled_refs")

  resultSnapshot Json?   @map("result_snapshot") // frozen AT1Result at prepare
  engineVersion  String  @default("") @map("engine_version") // {semver}+{rateYear}+{abHash}+{acciiYear}
  preparedAt     DateTime? @map("prepared_at")
  notes          String  @default("")
  createdById    String? @map("created_by_id")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([fiscalYearEnd, amendmentSeq])
  @@index([taxationYear])
  @@index([status])
  @@index([amendsId])
  @@map("at1_returns")
}

/**
 * T2ContinuityBalance — RDTOH / GRIP roll-forward, one row per fiscal year.
 *
 * Each year's OPENING balances = the prior year's filed CLOSING balances (mirrors
 * CcaScheduleEntry's filed-snapshot pattern). The FIRST filed year has no prior
 * row, so the openings are entered manually and `openingConfirmed` must be ticked
 * — the T2 verify gate BLOCKS prepare until it is true. For the locked persona
 * (active-income-only, GRIP $0) every opening is 0.
 */
model T2ContinuityBalance {
  id            String   @id @default(uuid())
  fiscalYearEnd DateTime @map("fiscal_year_end") @db.Date

  openingErdtoh    Decimal @default(0) @map("opening_erdtoh") @db.Decimal(14, 2)
  openingNerdtoh   Decimal @default(0) @map("opening_nerdtoh") @db.Decimal(14, 2)
  openingGrip      Decimal @default(0) @map("opening_grip") @db.Decimal(14, 2)
  // Prior-year aggregate-investment-income drives the SBD AAII grind (ITA
  // 125(5.1)(b)); 0 for the active-only persona, confirmed in the first year.
  priorYearAaii    Decimal @default(0) @map("prior_year_aaii") @db.Decimal(14, 2)
  openingConfirmed Boolean @default(false) @map("opening_confirmed") // blocks prepare in the first filed year

  // AS-FILED closing snapshot — frozen at prepare, becomes next year's opening.
  filedClosingErdtoh  Decimal? @map("filed_closing_erdtoh") @db.Decimal(14, 2)
  filedClosingNerdtoh Decimal? @map("filed_closing_nerdtoh") @db.Decimal(14, 2)
  filedClosingGrip    Decimal? @map("filed_closing_grip") @db.Decimal(14, 2)
  filedAt             DateTime? @map("filed_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fiscalYearEnd])
  @@map("t2_continuity_balances")
}

// ═══════════════════════════════════════════════════════════════════════════
// Forecasts (ported from WealthPilot). A scenario is one independent forecast
// workbook ("Personal", "Business"). Rows are monthly series (income, expense,
// debt); cells hold either a numeric amount or a formula string that the
// client-side engine evaluates (see src/lib/forecasts/formula.ts).
// Months are a contiguous range starting at (startYear, startMonth) with
// monthCount entries; cells/balances reference a month by 0-based index.
// ═══════════════════════════════════════════════════════════════════════════

model ForecastScenario {
  id         String @id @default(uuid())
  name       String
  kind       String @default("personal") // 'personal' | 'business'
  startYear  Int    @map("start_year")
  startMonth Int    @map("start_month") // 0-11
  monthCount Int    @default(12) @map("month_count")
  viewFrom   Int    @default(0) @map("view_from")
  viewTo     Int    @default(11) @map("view_to")
  sortOrder  Int    @default(0) @map("sort_order")

  rows          ForecastRow[]
  categories    ForecastCategory[]
  assets        ForecastAsset[]
  bankBalances  ForecastBankBalance[]
  rateOverrides ForecastRateOverride[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("forecast_scenarios")
}

// Expense grouping header (WealthPilot's "_Category" rows).
model ForecastCategory {
  id         String           @id @default(uuid())
  scenarioId String           @map("scenario_id")
  scenario   ForecastScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int              @default(0) @map("sort_order")
  rows       ForecastRow[]

  @@unique([scenarioId, name])
  @@map("forecast_categories")
}

model ForecastRow {
  id         String           @id @default(uuid())
  scenarioId String           @map("scenario_id")
  scenario   ForecastScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  section    String // 'income' | 'expense' | 'debt'
  name       String
  sortOrder  Int              @default(0) @map("sort_order")
  currency   String           @default("CAD") // income rows only
  hidden     Boolean          @default(false)

  // expense rows: owning category (null = uncategorized)
  categoryId String?           @map("category_id")
  category   ForecastCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // debt rows: balance mechanics
  debtType           String         @default("simple") @map("debt_type") // 'loan' | 'simple'
  interestRate       Decimal        @default(0) @map("interest_rate") @db.Decimal(7, 4) // annual %
  amortizationMonths Int?           @map("amortization_months")
  remainingMonths    Int?           @map("remaining_months")
  linkedExpenseId    String?        @map("linked_expense_id")
  linkedExpense      ForecastRow?   @relation("DebtLinkedExpense", fields: [linkedExpenseId], references: [id], onDelete: SetNull)
  linkedByDebts      ForecastRow[]  @relation("DebtLinkedExpense")
  linkedAssetId      String?        @map("linked_asset_id")
  linkedAsset        ForecastAsset? @relation("DebtLinkedAsset", fields: [linkedAssetId], references: [id], onDelete: SetNull)

  // assets that point at this debt row for equity math
  securedAssets ForecastAsset[] @relation("AssetLinkedDebt")

  cells    ForecastCell[]
  flowDays ForecastFlowDay[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scenarioId, section, name])
  @@index([scenarioId, section])
  @@index([categoryId])
  @@map("forecast_rows")
}

// One month of one row. Either a literal amount or a formula ("=income.Salary * 0.9").
model ForecastCell {
  id         String      @id @default(uuid())
  rowId      String      @map("row_id")
  row        ForecastRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  monthIndex Int         @map("month_index")
  amount     Decimal     @default(0) @db.Decimal(14, 2)
  formula    String?

  @@unique([rowId, monthIndex])
  @@map("forecast_cells")
}

// Day-of-month an income/expense cell lands on (drives the daily cash-flow
// timeline). kind 'override' = this month only; 'schedule' = from this month
// onward. day null = last day of the month.
model ForecastFlowDay {
  id         String      @id @default(uuid())
  rowId      String      @map("row_id")
  row        ForecastRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  monthIndex Int         @map("month_index")
  kind       String // 'override' | 'schedule'
  day        Int?

  @@unique([rowId, monthIndex, kind])
  @@map("forecast_flow_days")
}

model ForecastAsset {
  id              String           @id @default(uuid())
  scenarioId      String           @map("scenario_id")
  scenario        ForecastScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  name            String
  type            String           @default("other") // 'property' | 'vehicle' | 'investment' | 'cash' | 'other'
  value           Decimal          @default(0) @db.Decimal(14, 2)
  sortOrder       Int              @default(0) @map("sort_order")
  linkedDebtId    String?          @map("linked_debt_id")
  linkedDebt      ForecastRow?     @relation("AssetLinkedDebt", fields: [linkedDebtId], references: [id], onDelete: SetNull)
  linkedFromDebts ForecastRow[]    @relation("DebtLinkedAsset")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scenarioId, name])
  @@map("forecast_assets")
}

// Recorded "cash on hand" snapshot that re-anchors the running balance.
model ForecastBankBalance {
  id         String           @id @default(uuid())
  scenarioId String           @map("scenario_id")
  scenario   ForecastScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  monthIndex Int              @map("month_index")
  day        Int              @default(1)
  amount     Decimal          @db.Decimal(14, 2)

  @@unique([scenarioId, monthIndex])
  @@map("forecast_bank_balances")
}

// Manual FX override (units of CAD per 1 unit of currency) for a scenario.
model ForecastRateOverride {
  id         String           @id @default(uuid())
  scenarioId String           @map("scenario_id")
  scenario   ForecastScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  currency   String
  rate       Decimal          @db.Decimal(18, 8)

  @@unique([scenarioId, currency])
  @@map("forecast_rate_overrides")
}
