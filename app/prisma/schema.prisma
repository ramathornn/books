generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CompanySettings {
  id                  String   @id @default("singleton")
  name                String   @default("Your Company")
  legalName           String   @default("Your Company Inc.") @map("legal_name")
  logoInitials        String   @default("YC") @map("logo_initials")
  addressLine1        String   @default("") @map("address_line_1")
  addressLine2        String   @default("") @map("address_line_2")
  city                String   @default("")
  province            String   @default("")
  postalCode          String   @default("") @map("postal_code")
  country             String   @default("")
  phone               String   @default("")
  email               String   @default("")
  website             String   @default("")
  defaultCurrency     String   @default("CAD") @map("default_currency")
  defaultPaymentTerms String   @default("net30") @map("default_payment_terms")

  defaultSalesAccountId      String? @map("default_sales_account_id")
  defaultGstPayableAccountId String? @map("default_gst_payable_account_id")
  realizedFxAccountId        String? @map("realized_fx_account_id")

  // Wave 3 — tax filing identity + auto-pull account wiring
  businessNumber                 String  @default("") @map("business_number")
  rzAccountInfoReturns           String  @default("") @map("rz_account_info_returns")
  craTransmitterNumber           String  @default("") @map("cra_transmitter_number")
  gstNetfileAccessCode           String  @default("") @map("gst_netfile_access_code")
  gstFilingFrequency             String  @default("quarterly") @map("gst_filing_frequency")
  fiscalYearEndMonth             Int     @default(12) @map("fiscal_year_end_month")
  fiscalYearEndDay               Int     @default(31) @map("fiscal_year_end_day")
  dividendsDeclaredAccountId     String? @map("dividends_declared_account_id")
  subcontractorExpenseAccountId  String? @map("subcontractor_expense_account_id")
  // GL account whose expense is non-deductible (fines/penalties/interest on tax,
  // ITA 18(1)(t)/67.5/67.6) — fully added back on T2 Schedule 1. Null ⇒ buildT2
  // falls back to account number 6660.
  nonDeductibleExpenseAccountId  String? @map("non_deductible_expense_account_id")
  defaultItcReceivableAccountId  String? @map("default_itc_receivable_account_id")
  sinEncryptionKeyVersion        Int     @default(1) @map("sin_encryption_key_version")

  // Wave 4 — T2 corporate-return identity (additive, defaulted-empty).
  // Alberta Corporate Account Number (CAN): TRA-issued, 10 numeric digits. The
  // AT1 verify gate blocks prepare when this is empty (no real value seeded).
  albertaCorporateAccountNumber  String  @default("") @map("alberta_corporate_account_number")
  // Federal T2 program account = the 9-digit BN above + a corporate-income
  // program suffix (RC0001 form: 2 letters + 4 digits). Defaults to BN+RC0001,
  // confirmed once by the user. Stored as the FULL 15-char account string.
  t2ProgramAccount               String  @default("") @map("t2_program_account")

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("company_settings")
}

model User {
  id                           String          @id @default(uuid())
  name                         String
  email                        String          @unique
  hashedPassword               String
  // 'owner' — full access. 'accountant' — read-only everywhere: the proxy
  // rejects every mutating /api request from an accountant session (403);
  // only /api/auth/* self-service (password/2FA/passkeys) stays writable.
  role                         String          @default("owner")
  totpSecret                   String?         @map("totp_secret")
  totpEnabled                  Boolean         @default(false) @map("totp_enabled")
  passkeyPromptDismissed       Boolean         @default(false) @map("passkey_prompt_dismissed")
  defaultOnlinePaymentsEnabled Boolean         @default(false) @map("default_online_payments_enabled")
  defaultAllowPartialPayments  Boolean         @default(false) @map("default_allow_partial_payments")
  authenticators               Authenticator[]
  createdAt                    DateTime        @default(now())
  updatedAt                    DateTime        @updatedAt
}

// Pending user invitation. The owner creates one in Settings → Users & Access
// and shares the /invite/<token> link out-of-band; accepting it creates the
// User with the invite's role and marks the invite consumed.
model UserInvite {
  id         String    @id @default(uuid())
  email      String
  role       String    @default("accountant") // owner | accountant
  token      String    @unique // 64-char hex, single-use
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("user_invites")
}

model Authenticator {
  id           String    @id @default(uuid())
  credentialId String    @unique @map("credential_id")
  publicKey    Bytes     @map("public_key")
  counter      Int       @default(0)
  transports   String    @default("")
  deviceName   String    @default("Passkey") @map("device_name")
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime? @map("last_used_at")

  @@index([userId])
  @@map("authenticators")
}

model WebauthnLoginToken {
  token     String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("webauthn_login_tokens")
}

model Client {
  id           String      @id @default(uuid())
  fbId         String?     @unique @map("fb_id")
  firstName    String
  lastName     String
  organization String      @default("")
  email        String      @default("")
  phone        String      @default("")
  address      String      @default("")
  country      String      @default("")
  vatId        String      @default("") @map("vat_id")
  currency     String      @default("CAD")
  internalNote String      @default("") @map("internal_note")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  invoices     Invoice[]
  estimates    Estimate[]
  payments     Payment[]
  expenses     Expense[]
  projects     Project[]
  timeEntries  TimeEntry[]
  taxParties   TaxParty[]

  @@map("clients")
}

model Invoice {
  id                    String            @id @default(uuid())
  fbId                  String?           @unique @map("fb_id")
  invoiceNumber         String            @unique @map("invoice_number")
  status                String            @default("draft")
  currency              String            @default("CAD")
  dateIssued            DateTime          @map("date_issued")
  dateDue               DateTime          @map("date_due")
  subtotal              Decimal           @db.Decimal(12, 2)
  taxTotal              Decimal           @default(0) @map("tax_total") @db.Decimal(12, 2)
  total                 Decimal           @db.Decimal(12, 2)
  amountPaid            Decimal           @default(0) @map("amount_paid") @db.Decimal(12, 2)
  amountDue             Decimal           @default(0) @map("amount_due") @db.Decimal(12, 2)
  description           String            @default("")
  reference             String            @default("")
  notes                 String            @default("")
  terms                 String            @default("")
  shareToken            String            @unique @map("share_token")
  clientId              String            @map("client_id")
  client                Client            @relation(fields: [clientId], references: [id])
  lineItems             InvoiceLineItem[]
  payments              Payment[]
  activities            InvoiceActivity[]
  discount              Decimal           @default(0) @db.Decimal(12, 2)
  sourceEstimateId      String?           @map("source_estimate_id")
  onlinePaymentsEnabled Boolean           @default(false) @map("online_payments_enabled")
  allowPartialPayments  Boolean           @default(false) @map("allow_partial_payments")

  journalEntryId     String?       @unique @map("journal_entry_id")
  journalEntry       JournalEntry? @relation("InvoiceAccrualJE", fields: [journalEntryId], references: [id])
  voidJournalEntryId String?       @map("void_journal_entry_id")
  voidedAt           DateTime?     @map("voided_at")
  // Bad-debt write-off: status may become 'bad_debt'; records the AR write-off JE.
  writtenOffAt         DateTime? @map("written_off_at")
  writeOffJournalEntryId String? @map("write_off_journal_entry_id")
  fxRate             Decimal?      @map("fx_rate") @db.Decimal(18, 8)
  fxRateSource       String        @default("") @map("fx_rate_source")
  fxRateDate         DateTime?     @map("fx_rate_date")
  cadTotal           Decimal?      @map("cad_total") @db.Decimal(12, 2)
  cadSubtotal        Decimal?      @map("cad_subtotal") @db.Decimal(12, 2)
  cadTaxTotal        Decimal?      @map("cad_tax_total") @db.Decimal(12, 2)
  cadReliefToDate    Decimal       @default(0) @map("cad_relief_to_date") @db.Decimal(12, 2)

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([invoiceNumber])
  @@index([clientId])
  @@index([status])
  @@index([dateIssued])
  @@index([shareToken])
  @@index([currency])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String   @id @default(uuid())
  title       String   @default("")
  description String   @default("")
  rate        Decimal  @db.Decimal(12, 2)
  quantity    Decimal  @db.Decimal(12, 2)
  lineTotal   Decimal  @map("line_total") @db.Decimal(12, 2)
  taxCodes    String[] @map("tax_codes")
  invoiceId   String   @map("invoice_id")
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sortOrder   Int      @default(0) @map("sort_order")

  @@map("invoice_line_items")
}

model Estimate {
  id             String             @id @default(uuid())
  fbId           String?            @unique @map("fb_id")
  estimateNumber String             @unique @map("estimate_number")
  status         String             @default("draft")
  currency       String             @default("CAD")
  dateIssued     DateTime           @map("date_issued")
  subtotal       Decimal            @db.Decimal(12, 2)
  taxTotal       Decimal            @default(0) @map("tax_total") @db.Decimal(12, 2)
  total          Decimal            @db.Decimal(12, 2)
  description    String             @default("")
  notes          String             @default("")
  terms          String             @default("")
  shareToken     String             @unique @map("share_token")
  clientId       String             @map("client_id")
  client         Client             @relation(fields: [clientId], references: [id])
  lineItems      EstimateLineItem[]
  response       EstimateResponse?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([estimateNumber])
  @@index([clientId])
  @@index([status])
  @@index([dateIssued])
  @@index([shareToken])
  @@map("estimates")
}

model EstimateResponse {
  id          String   @id @default(uuid())
  estimateId  String   @unique @map("estimate_id")
  estimate    Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  status      String // accepted or declined
  signerName  String   @map("signer_name")
  signerEmail String   @map("signer_email")
  ipAddress   String   @default("") @map("ip_address")
  userAgent   String   @default("") @map("user_agent")
  createdAt   DateTime @default(now())

  @@index([estimateId])
  @@map("estimate_responses")
}

model EstimateLineItem {
  id          String   @id @default(uuid())
  title       String   @default("")
  description String   @default("")
  rate        Decimal  @db.Decimal(12, 2)
  quantity    Decimal  @db.Decimal(12, 2)
  lineTotal   Decimal  @map("line_total") @db.Decimal(12, 2)
  taxCodes    String[] @map("tax_codes")
  estimateId  String   @map("estimate_id")
  estimate    Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  sortOrder   Int      @default(0) @map("sort_order")

  @@map("estimate_line_items")
}

model Payment {
  id                    String   @id @default(uuid())
  paymentDate           DateTime @map("payment_date")
  paymentMethod         String   @map("payment_method")
  amount                Decimal  @db.Decimal(12, 2)
  currency              String   @default("CAD")
  notes                 String   @default("")
  status                String   @default("paid")
  source                String   @default("manual") // manual | stripe
  stripePaymentIntentId String?  @unique @map("stripe_payment_intent_id")
  stripeChargeId        String?  @map("stripe_charge_id")
  stripeStatus          String?  @map("stripe_status")
  invoiceId             String   @map("invoice_id")
  invoice               Invoice  @relation(fields: [invoiceId], references: [id])
  clientId              String   @map("client_id")
  client                Client   @relation(fields: [clientId], references: [id])

  cadAmount        Decimal?  @map("cad_amount") @db.Decimal(12, 2)
  cadArRelief      Decimal?  @map("cad_ar_relief") @db.Decimal(12, 2)
  fxRate           Decimal?  @map("fx_rate") @db.Decimal(18, 8)
  fxRateDate       DateTime? @map("fx_rate_date")
  journalEntryId   String?   @unique @map("journal_entry_id")

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([invoiceId])
  @@index([clientId])
  @@index([paymentDate])
  @@index([stripePaymentIntentId])
  @@map("payments")
}

// Reusable message bodies for "Send by Email" — may contain shortcodes:
// {{invoice.link}}, {{link:label|href}}, {{invoice.number}}, {{invoice.amount}}, {{invoice.dueDate}}
model EmailTemplate {
  id        String   @id @default(uuid())
  name      String
  subject   String   @default("")
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}

model InvoiceActivity {
  id          String   @id @default(uuid())
  invoiceId   String   @map("invoice_id")
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type        String // created, sent, viewed, payment_added, emailed
  description String
  amount      Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_activities")
}

model Item {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  rate        Decimal  @db.Decimal(12, 2)
  taxes       String   @default("")
  category    String   @default("service")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("items")
}

model TeamMember {
  id          String      @id @default(uuid())
  firstName   String      @map("first_name")
  lastName    String      @map("last_name")
  email       String      @unique
  jobTitle    String?     @map("job_title")
  role        String      @default("employee") // owner | admin | employee
  status      String      @default("active") // active | deleted
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  timeEntries TimeEntry[]

  @@map("team_members")
}

// ---------- EXPENSES ----------

model ExpenseCategory {
  id          String            @id @default(uuid())
  name        String
  groupName   String            @default("Operating Expenses") @map("group_name")
  parentId    String?           @map("parent_id")
  parent      ExpenseCategory?  @relation("ExpenseCategorySubs", fields: [parentId], references: [id])
  children    ExpenseCategory[] @relation("ExpenseCategorySubs")
  glAccountId String?           @map("gl_account_id")
  glAccount   GLAccount?        @relation(fields: [glAccountId], references: [id])
  isArchived  Boolean           @default(false) @map("is_archived")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  expenses    Expense[]
  vendors     Vendor[]

  @@unique([name, groupName])
  @@map("expense_categories")
}

model Vendor {
  id                String           @id @default(uuid())
  name              String           @unique
  displayName       String           @default("") @map("display_name")
  contactName       String           @default("") @map("contact_name")
  email             String           @default("")
  phone             String           @default("")
  website           String           @default("")
  address           String           @default("")
  gstNumber         String           @default("") @map("gst_number")
  defaultCategoryId String?          @map("default_category_id")
  defaultCategory   ExpenseCategory? @relation(fields: [defaultCategoryId], references: [id])
  defaultTaxCodeId  String?          @map("default_tax_code_id")
  defaultPayee      String           @default("") @map("default_payee")
  isContractor      Boolean          @default(false) @map("is_contractor") // tracks T4A eligibility for future
  isArchived        Boolean          @default(false) @map("is_archived")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  expenses          Expense[]
  bills             Bill[]
  taxParties        TaxParty[]
  aliases           VendorAlias[]

  @@map("vendors")
}

/// Learned merchant-descriptor → Vendor mappings. A cryptic bank descriptor
/// ("DNH*GODADDY") is normalised to a key and, once a human (or an auto-apply
/// rule) confirms which vendor it is, remembered here so the next import of the
/// same descriptor resolves the vendor with zero guessing. Purely additive — the
/// normalised merchant text is derived in-memory from a BankTransaction's
/// payee/description, never stored on the transaction itself.
model VendorAlias {
  id            String   @id @default(uuid())
  normalizedKey String   @unique @map("normalized_key") // norm(merchant text), e.g. "dnhgodaddy"
  vendorId      String   @map("vendor_id")
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  source        String   @default("") // "confirm" | "rule" | "auto" (provenance)
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("vendor_aliases")
}

model Expense {
  id                 String          @id @default(uuid())
  date               DateTime
  amount             Decimal         @db.Decimal(12, 2)
  taxAmount          Decimal         @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total              Decimal         @db.Decimal(12, 2)
  currency           String          @default("CAD")
  description        String          @default("")
  notes              String          @default("")
  status             String          @default("pending") // pending | billable | non-billable | invoiced
  source             String          @default("")
  receiptUrl         String          @default("") @map("receipt_url")
  isBillable         Boolean         @default(false) @map("is_billable")
  isRecurring        Boolean         @default(false) @map("is_recurring")
  isArchived         Boolean         @default(false) @map("is_archived")
  isReceiptDraft     Boolean         @default(false) @map("is_receipt_draft") // for the receipts inbox flow
  recurringFrequency String?         @map("recurring_frequency") // daily | weekly | monthly | quarterly | annually
  recurringEndDate   DateTime?       @map("recurring_end_date")
  categoryId         String          @map("category_id")
  category           ExpenseCategory @relation(fields: [categoryId], references: [id])
  vendorId           String?         @map("vendor_id")
  vendor             Vendor?         @relation(fields: [vendorId], references: [id])
  clientId           String?         @map("client_id")
  client             Client?         @relation(fields: [clientId], references: [id])
  projectId          String?         @map("project_id")
  project            Project?        @relation(fields: [projectId], references: [id])
  taxCodeId          String?         @map("tax_code_id")
  storedFiles        StoredFile[]    // receipt files filed into the Files manager
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([date])
  @@index([categoryId])
  @@index([clientId])
  @@index([status])
  @@map("expenses")
}

// ---------- PROJECTS & TIME TRACKING ----------

model Project {
  id          String      @id @default(uuid())
  name        String
  description String      @default("")
  clientId    String?     @map("client_id")
  client      Client?     @relation(fields: [clientId], references: [id])
  hourlyRate  Decimal?    @map("hourly_rate") @db.Decimal(10, 2)
  currency    String      @default("CAD")
  isArchived  Boolean     @default(false) @map("is_archived")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  timeEntries TimeEntry[]
  expenses    Expense[]

  @@index([clientId])
  @@map("projects")
}

model Service {
  id          String      @id @default(uuid())
  name        String      @unique
  description String      @default("")
  hourlyRate  Decimal?    @map("hourly_rate") @db.Decimal(10, 2)
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  timeEntries TimeEntry[]

  @@map("services")
}

model TimeEntry {
  id              String      @id @default(uuid())
  date            DateTime
  durationMinutes Int         @map("duration_minutes")
  description     String      @default("")
  notes           String      @default("")
  isBillable      Boolean     @default(true) @map("is_billable")
  isTimerBased    Boolean     @default(false) @map("is_timer_based")
  isInvoiced      Boolean     @default(false) @map("is_invoiced")
  invoiceId       String?     @map("invoice_id")
  rate            Decimal?    @db.Decimal(10, 2)
  currency        String      @default("CAD")
  teamMemberId    String?     @map("team_member_id")
  teamMember      TeamMember? @relation(fields: [teamMemberId], references: [id])
  clientId        String?     @map("client_id")
  client          Client?     @relation(fields: [clientId], references: [id])
  projectId       String?     @map("project_id")
  project         Project?    @relation(fields: [projectId], references: [id])
  serviceId       String?     @map("service_id")
  service         Service?    @relation(fields: [serviceId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([date])
  @@index([clientId])
  @@index([projectId])
  @@index([teamMemberId])
  @@map("time_entries")
}

// ---------- ACCOUNTING ----------

model GLAccount {
  id                 String             @id @default(uuid())
  accountNumber      String             @unique @map("account_number")
  accountName        String             @map("account_name")
  description        String             @default("")
  accountClass       String             @map("account_class") // asset | liability | equity | income | expense
  accountSubclass    String             @default("") @map("account_subclass")
  detailType         String             @default("") @map("detail_type") // e.g. Bank, Accounts receivable (A/R), Credit Card, Other Current Liabilities, Long-term Liabilities, Property, plant and equipment, Income, Other Income, Cost of Goods Sold, Expenses, Other Expense, Equity, Current assets
  gifiCode           String?            @map("gifi_code") // CRA General Index of Financial Information 4-digit code (T2 mapping); nullable — accountant completes from prior-year T2
  // T2 active/passive split for the CCPC machinery (AII / ART / RDTOH / Part IV /
  // SBD grind). Values: 'active' | 'investment' | 'capitalGains'. Null = not yet
  // classified — the GIFI pre-flight DEFAULTS operating income/expense accounts
  // to 'active' and only forces a choice for passive-looking accounts (Other
  // Income, or interest/dividend/rental/royalty/gain). When everything is active,
  // AII=0 so ART/RDTOH/Part IV/dividend-refund all degrade to 0.
  incomeNature       String?            @map("income_nature")
  // Statement of Cash Flows section override: 'operating' | 'investing' | 'financing'.
  // Null = derive automatically (see lib/reports/cashFlow.ts classifier).
  cashFlowSection    String?            @map("cash_flow_section")
  parentId           String?            @map("parent_id")
  parent             GLAccount?         @relation("GLAccountHierarchy", fields: [parentId], references: [id])
  children           GLAccount[]        @relation("GLAccountHierarchy")
  currency           String             @default("CAD")
  isReconcilable     Boolean            @default(false) @map("is_reconcilable")
  isActive           Boolean            @default(true) @map("is_active")
  isArchived         Boolean            @default(false) @map("is_archived")
  openingBalance     Decimal            @default(0) @map("opening_balance") @db.Decimal(15, 2)
  openingBalanceDate DateTime?          @map("opening_balance_date")
  currentBalance     Decimal            @default(0) @map("current_balance") @db.Decimal(15, 2)
  defaultTaxCodeId   String?            @map("default_tax_code_id")
  defaultTaxCode     TaxCode?           @relation(fields: [defaultTaxCodeId], references: [id])
  sortOrder          Int                @default(0) @map("sort_order")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  journalLines       JournalEntryLine[]
  expenseCategories  ExpenseCategory[]
  bankAccount        BankAccount?

  @@index([accountClass])
  @@index([detailType])
  @@map("gl_accounts")
}

model TaxCode {
  id                  String      @id @default(uuid())
  code                String      @unique // GST_INCOME, GST_EXPENSE, ZERO_RATED, OUT_OF_SCOPE, MEALS_50
  name                String // human display: "GST on Income", "GST on Expenses", etc.
  description         String      @default("")
  rate                Decimal     @default(0) @db.Decimal(6, 4) // 0.0500 for 5%
  appliesTo           String      @default("both") // sale | purchase | both
  isReportable        Boolean     @default(true) @map("is_reportable") // appears on GST/HST filing
  isRecoverable       Boolean     @default(true) @map("is_recoverable") // ITC eligible
  deductiblePct       Decimal     @default(100) @map("deductible_pct") @db.Decimal(5, 2) // 50 for Meals
  payableAccountId    String?     @map("payable_account_id") // GL for tax collected (e.g. 2315 GST/HST Payable)
  receivableAccountId String?     @map("receivable_account_id") // GL for ITC receivable
  isArchived          Boolean     @default(false) @map("is_archived")
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  glAccounts          GLAccount[]

  @@map("tax_codes")
}

model JournalEntry {
  id          String             @id @default(uuid())
  entryNumber String             @unique @map("entry_number")
  entryDate   DateTime           @map("entry_date")
  description String             @default("")
  memo        String             @default("")
  status      String             @default("draft") // draft | posted | void
  totalDebit  Decimal            @default(0) @map("total_debit") @db.Decimal(15, 2)
  totalCredit Decimal            @default(0) @map("total_credit") @db.Decimal(15, 2)
  postedAt    DateTime?          @map("posted_at")

  kind           String        @default("standard") @map("kind")
  // Client-supplied dedupe key (e.g. declare-dividend). Unique, so a retried
  // request can never book the same economic event twice.
  idempotencyKey String?       @unique @map("idempotency_key")
  // For kind=='dividend' only: tags the declaration as 'eligible' | 'nonEligible' so
  // T5 generation routes the actual amount to the correct boxes (eligible -> 24/25/26;
  // non-eligible -> 10/11/12) and the T1 pull can derive the 12000/12010/40425 split.
  // Null on every non-dividend entry.
  dividendEligibility String?    @map("dividend_eligibility")
  reversesId     String?       @unique @map("reverses_id")
  reverses       JournalEntry? @relation("JEReversal", fields: [reversesId], references: [id])
  reversal       JournalEntry? @relation("JEReversal")
  reversedAt     DateTime?     @map("reversed_at")
  reversedReason String?       @map("reversed_reason")
  invoiceAccrual Invoice?      @relation("InvoiceAccrualJE")

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  lines       JournalEntryLine[]

  @@index([entryDate])
  @@index([status])
  @@index([reversesId])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String       @id @default(uuid())
  journalEntryId String       @map("journal_entry_id")
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  glAccountId    String       @map("gl_account_id")
  glAccount      GLAccount    @relation(fields: [glAccountId], references: [id])
  description    String       @default("")
  debit          Decimal      @default(0) @db.Decimal(15, 2)
  credit         Decimal      @default(0) @db.Decimal(15, 2)
  taxCodeId      String?      @map("tax_code_id")
  sortOrder      Int          @default(0) @map("sort_order")

  @@index([journalEntryId])
  @@index([glAccountId])
  @@map("journal_entry_lines")
}

model FxRate {
  id         String   @id @default(uuid())
  currency   String
  rateDate   DateTime @map("rate_date") @db.Date
  cadPerUnit Decimal  @map("cad_per_unit") @db.Decimal(18, 8)
  source     String   @default("boc_valet")
  seriesName String   @default("") @map("series_name")
  fetchedAt  DateTime @default(now()) @map("fetched_at")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([currency, rateDate])
  @@index([currency, rateDate])
  @@map("fx_rates")
}

model BankAccount {
  id                  String            @id @default(uuid())
  glAccountId         String            @unique @map("gl_account_id")
  glAccount           GLAccount         @relation(fields: [glAccountId], references: [id])
  bankName            String            @map("bank_name")
  accountNumberMasked String            @default("") @map("account_number_masked")
  accountHolder       String            @default("") @map("account_holder")
  accountType         String            @default("checking") @map("account_type") // checking | savings | credit_card | cash | wallet
  statementClosingDay Int?              @map("statement_closing_day") // day of month statement closes
  isConnected         Boolean           @default(false) @map("is_connected")
  lastSyncAt          DateTime?         @map("last_sync_at")
  lastReconciledAt    DateTime?         @map("last_reconciled_at")
  reconciledBalance   Decimal           @default(0) @map("reconciled_balance") @db.Decimal(15, 2)
  isArchived          Boolean           @default(false) @map("is_archived")
  sortOrder           Int               @default(0) @map("sort_order")
  // Plaid link: which Plaid Item (institution connection) + Plaid account this
  // maps to, and the earliest date to pull transactions from.
  plaidItemId         String?           @map("plaid_item_id")
  plaidItem           PlaidItem?        @relation(fields: [plaidItemId], references: [id])
  plaidAccountId      String?           @map("plaid_account_id")
  plaidSyncFrom       DateTime?         @map("plaid_sync_from")
  // Live balance pulled from Plaid on each sync (the bank's reported balance,
  // to reconcile against the book balance / GLAccount.currentBalance).
  plaidCurrentBalance   Decimal?        @map("plaid_current_balance") @db.Decimal(15, 2)
  plaidAvailableBalance Decimal?        @map("plaid_available_balance") @db.Decimal(15, 2)
  plaidBalanceAt        DateTime?       @map("plaid_balance_at")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  transactions        BankTransaction[]

  @@index([plaidItemId])
  @@map("bank_accounts")
}

// One Plaid "Item" = one connection to a financial institution (which may
// expose several accounts). The access token is stored encrypted at rest.
model PlaidItem {
  id              String        @id @default(uuid())
  itemId          String        @unique @map("item_id")
  institutionId   String        @default("") @map("institution_id")
  institutionName String        @default("") @map("institution_name")
  accessTokenEnc  String        @map("access_token_enc") // AES-256-GCM, see lib/crypto
  cursor          String?       // /transactions/sync cursor
  status          String        @default("active") // active | login_required | error | disconnected
  lastError       String?       @map("last_error")
  lastSyncAt      DateTime?     @map("last_sync_at")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  bankAccounts    BankAccount[]

  @@map("plaid_items")
}

// A connected Stripe account used as a READ-ONLY revenue source: its balance
// transactions (charges, fees, refunds, payouts) are synced into per-charge
// journal entries. Mirrors PlaidItem (a bank source) — the restricted key is
// stored encrypted at rest (lib/crypto), and the GL account mapping is held
// per-connection so the posting model writes into this tenant's own chart of
// accounts rather than any hardcoded ids.
model StripeConnection {
  id           String @id @default(uuid())
  displayName  String @default("") @map("display_name")
  accountId    String @default("") @map("stripe_account_id") // acct_… (informational)
  secretKeyEnc String @map("secret_key_enc") // restricted read-only key, AES-256-GCM

  // GL account mapping (GLAccount ids) the posting model writes to.
  revenueAccountId           String @map("revenue_account_id")
  feeAccountId               String @map("fee_account_id")
  clearingAccountId          String @map("clearing_account_id")
  gstPayableAccountId        String @map("gst_payable_account_id")
  payoutDestinationAccountId String @map("payout_destination_account_id")
  gstTaxCodeId               String @map("gst_tax_code_id")
  zeroRatedTaxCodeId         String @map("zero_rated_tax_code_id")

  cursor     String? // last balance-transaction id synced (incremental poll)
  status     String    @default("active") // active | error | disconnected
  lastError  String?   @map("last_error")
  lastSyncAt DateTime? @map("last_sync_at")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("stripe_connections")
}

model BankTransaction {
  id                      String      @id @default(uuid())
  bankAccountId           String      @map("bank_account_id")
  bankAccount             BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  transactionDate         DateTime    @map("transaction_date")
  description             String      @default("")
  amount                  Decimal     @db.Decimal(15, 2) // negative = money out, positive = money in
  balanceAfter            Decimal?    @map("balance_after") @db.Decimal(15, 2)
  status                  String      @default("pending") // pending | posted | excluded
  payee                   String      @default("")
  memo                    String      @default("")
  categoryId              String?     @map("category_id") // ExpenseCategory or GLAccount id (for income)
  categoryGlAccountId     String?     @map("category_gl_account_id")
  vendorId                String?     @map("vendor_id")
  taxCodeId               String?     @map("tax_code_id")
  journalEntryId          String?     @map("journal_entry_id")
  matchedInvoiceId        String?     @map("matched_invoice_id")
  matchedPaymentId        String?     @map("matched_payment_id")
  matchedExpenseId        String?     @map("matched_expense_id")
  bankImportRuleId        String?     @map("bank_import_rule_id")
  importBatchId           String?     @map("import_batch_id")
  dedupeHash              String?     @map("dedupe_hash")
  plaidTransactionId      String?     @map("plaid_transaction_id") // Plaid transaction_id; upsert/remove key for synced rows
  transferPairId          String?     @map("transfer_pair_id") // links the two sides of a posted account-to-account transfer
  isReconciled            Boolean     @default(false) @map("is_reconciled")
  reconciledAt            DateTime?   @map("reconciled_at")
  reconciliationSessionId String?     @map("reconciliation_session_id")
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @default(now()) @updatedAt

  // Unique per account: Plaid's transaction_id is the canonical upsert/remove key.
  // Nullable, so non-Plaid (CSV/manual) rows — which leave this NULL — are exempt
  // (Postgres treats NULLs as distinct). Guards against a re-sent id being inserted
  // twice by a sync race; the importer also collapses within-batch repeats.
  @@unique([bankAccountId, plaidTransactionId])
  @@index([bankAccountId])
  @@index([transactionDate])
  @@index([status])
  @@index([dedupeHash])
  @@index([transferPairId])
  @@map("bank_transactions")
}

model Mileage {
  id           String   @id @default(uuid())
  date         DateTime
  fromAddress  String   @default("") @map("from_address")
  toAddress    String   @default("") @map("to_address")
  kilometres   Decimal  @db.Decimal(10, 2)
  purpose      String   @default("")
  vehicleLabel String   @default("") @map("vehicle_label") // free-text since we don't model Vehicle as its own entity
  ratePerKm    Decimal  @default(0.70) @map("rate_per_km") @db.Decimal(10, 4) // CRA 2025: $0.70/km first 5000km
  amount       Decimal  @db.Decimal(12, 2) // computed = kilometres * ratePerKm
  expenseId    String?  @map("expense_id") // set when materialized as an Expense
  isArchived   Boolean  @default(false) @map("is_archived")
  notes        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([date])
  @@map("mileage_logs")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  userName   String   @default("") @map("user_name")
  entityType String   @map("entity_type") // invoice | bill | expense | journal_entry | bank_transaction | gl_account | reconciliation | tax_return | period_lock
  entityId   String   @map("entity_id")
  action     String // create | update | delete | post | void | categorize | match | reconcile | finish | exclude | unpost | run
  summary    String   @default("") // short human description
  before     Json? // optional payload snapshot before
  after      Json? // optional payload snapshot after
  metadata   Json? // arbitrary tags
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([entityType, createdAt])
  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}

model AccountingPeriod {
  id            String    @id @default("singleton")
  // Books are locked through this date inclusive. Null = nothing locked.
  lockedThrough DateTime? @map("locked_through")
  lockedAt      DateTime? @map("locked_at")
  lockedById    String?   @map("locked_by_id")
  notes         String    @default("")
  updatedAt     DateTime  @updatedAt

  @@map("accounting_periods")
}

model TaxReturn {
  id                       String    @id @default(uuid())
  type                     String    @default("GST/HST") // GST/HST | Provincial Sales Tax
  periodStart              DateTime  @map("period_start")
  periodEnd                DateTime  @map("period_end")
  collectedAmount          Decimal   @default(0) @map("collected_amount") @db.Decimal(15, 2)
  paidAmount               Decimal   @default(0) @map("paid_amount") @db.Decimal(15, 2)
  adjustment               Decimal   @default(0) @db.Decimal(15, 2)
  netAmount                Decimal   @default(0) @map("net_amount") @db.Decimal(15, 2)
  status                   String    @default("draft") // draft | prepared | filed | paid | void
  preparedAt               DateTime? @map("prepared_at")
  filedAt                  DateTime? @map("filed_at")
  paidAt                   DateTime? @map("paid_at")
  remitJournalEntryId      String?   @map("remit_journal_entry_id")
  paymentBankTransactionId String?   @map("payment_bank_transaction_id")
  // Wave 3 — GST34 worksheet extensions
  filingFrequency          String    @default("quarterly") @map("filing_frequency")
  reportingMethod          String    @default("regular") @map("reporting_method")
  gst34Detail              Json?     @map("gst34_detail") // frozen snapshot {line101..115, sources:{...}}
  printableStoredFileId    String?   @map("printable_stored_file_id") // plain id, NO StoredFile relation
  notes                    String    @default("")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@unique([type, periodStart, periodEnd])
  @@index([status])
  @@map("tax_returns")
}

model ReconciliationSession {
  id                 String    @id @default(uuid())
  bankAccountId      String    @map("bank_account_id")
  statementStartDate DateTime  @map("statement_start_date")
  statementEndDate   DateTime  @map("statement_end_date")
  beginningBalance   Decimal   @map("beginning_balance") @db.Decimal(15, 2)
  endingBalance      Decimal   @map("ending_balance") @db.Decimal(15, 2)
  status             String    @default("in_progress") // in_progress | completed | abandoned
  completedAt        DateTime? @map("completed_at")
  completedById      String?   @map("completed_by_id")
  clearedDebits      Decimal   @default(0) @map("cleared_debits") @db.Decimal(15, 2)
  clearedCredits     Decimal   @default(0) @map("cleared_credits") @db.Decimal(15, 2)
  notes              String    @default("")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([bankAccountId])
  @@index([status])
  @@map("reconciliation_sessions")
}

// Per bank account + month lock. Blocks edits to a reconciled month for that
// account. Unique on (bankAccountId, periodStart).
