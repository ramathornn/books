  lockedAt      DateTime @default(now()) @map("locked_at")
  lockedBy      String?  @map("locked_by")

  @@unique([bankAccountId, periodStart])
  @@index([bankAccountId])
  @@map("reconciliation_locks")
}

// Records a year-end close run: rolls net income into retained earnings.
model FiscalYearClose {
