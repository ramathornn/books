model CcaScheduleEntry {
  id                 String   @id @default(uuid())
  classId            String   @map("class_id")
  ccaClass           CcaClass @relation(fields: [classId], references: [id])
  taxYear            Int      @map("tax_year")
  openingUcc         Decimal  @map("opening_ucc") @db.Decimal(15, 2)
  additions          Decimal  @default(0) @db.Decimal(15, 2)
  dispositions       Decimal  @default(0) @db.Decimal(15, 2)
  halfYearAdjustment Decimal  @default(0) @map("half_year_adjustment") @db.Decimal(15, 2)
  accIiAddition      Decimal  @default(0) @map("acc_ii_addition") @db.Decimal(15, 2)
  ccaRate            Decimal  @map("cca_rate") @db.Decimal(6, 4)
  ccaBase            Decimal  @default(0) @map("cca_base") @db.Decimal(15, 2)
  ccaMax             Decimal  @default(0) @map("cca_max") @db.Decimal(15, 2)
  ccaClaimed         Decimal  @default(0) @map("cca_claimed") @db.Decimal(15, 2)
  closingUcc         Decimal  @map("closing_ucc") @db.Decimal(15, 2)
  method             String   @default("half_year") // half_year | accii | diep | full | none
  status             String   @default("draft") // draft | posted | locked
  isSeed             Boolean  @default(false) @map("is_seed")
  isCatchUp          Boolean  @default(false) @map("is_catch_up") // prior-period correction booked here
  catchUpForYear     Int?     @map("catch_up_for_year") // the locked year this corrects
  isOverridden       Boolean  @default(false) @map("is_overridden")
  overrides          Json?
  // AS-FILED snapshot — frozen when status->locked, NEVER touched by recompute
  filedOpeningUcc    Decimal?  @map("filed_opening_ucc") @db.Decimal(15, 2)
  filedCcaClaimed    Decimal?  @map("filed_cca_claimed") @db.Decimal(15, 2)
  filedClosingUcc    Decimal?  @map("filed_closing_ucc") @db.Decimal(15, 2)
  filedAt            DateTime? @map("filed_at")
  journalEntryId     String?   @unique @map("journal_entry_id")
  postedAt           DateTime? @map("posted_at")
  notes              String    @default("")
