  bill              Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  paymentDate       DateTime @map("payment_date")
  amount            Decimal  @db.Decimal(12, 2)
  bankAccountId     String?  @map("bank_account_id")
  bankTransactionId String?  @map("bank_transaction_id")
  journalEntryId    String?  @map("journal_entry_id")
  paymentMethod     String   @default("Bank Transfer") @map("payment_method")
  reference         String   @default("")
  createdAt         DateTime @default(now())

  @@index([billId])
  @@index([paymentDate])
  @@map("bill_payments")
}

model RecurringTemplate {
  id              String    @id @default(uuid())
  templateName    String    @map("template_name")
  transactionType String    @map("transaction_type") // invoice | bill | expense | journal_entry
  intervalUnit    String    @map("interval_unit") // day | week | month | quarter | year
  intervalCount   Int       @default(1) @map("interval_count")
  mode            String    @default("reminder") // auto_create | reminder | unscheduled
  startDate       DateTime  @map("start_date")
  endDate         DateTime? @map("end_date")
  nextRunDate     DateTime? @map("next_run_date")
  previousRunDate DateTime? @map("previous_run_date")
  payload         Json      @default("{}")
  isActive        Boolean   @default(true) @map("is_active")
  runCount        Int       @default(0) @map("run_count")
  notes           String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([nextRunDate])
  @@index([isActive])
  @@map("recurring_templates")
}

model BankRule {
  id                  String    @id @default(uuid())
  name                String
  priority            Int       @default(0)
  // Scope:
  moneyDirection      String    @default("both") // in | out | both
  accountScope        String    @default("all") // all | specific
  // When accountScope='specific', list of bank account IDs (kept as JSON array of strings)
  accountIds          String[]  @default([]) @map("account_ids")
  // Match logic:
  conditionLogic      String    @default("any") // all | any
  conditions          Json      @default("[]") // [{field: bankText|description|amount|amountSign|date, op, value}]
  // Simple text-match shorthand (alongside structured `conditions`):
  pattern             String    @default("") // text to match against the bank description/text
  matchType           String    @default("contains") // exact | contains | regex
  // Action:
  thenTransactionType String    @default("expense") @map("then_transaction_type") // expense | income | transfer | exclude
  categoryGlAccountId String?   @map("category_gl_account_id")
  categoryId          String?   @map("category_id") // ExpenseCategory FK (display only)
  vendorId            String?   @map("vendor_id")
  payee               String    @default("")
  taxCodeId           String?   @map("tax_code_id")
  memo                String    @default("")
  memoAppend          String    @default("") @map("memo_append")
  splits              Json      @default("[]") // [{categoryGlAccountId, amount, percent, taxCodeId}] — empty array means single line
  autoAdd             Boolean   @default(false) @map("auto_add")
  isActive            Boolean   @default(true) @map("is_active")
  // Audit
  matchCount          Int       @default(0) @map("match_count")
  lastMatchedAt       DateTime? @map("last_matched_at")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([priority])
  @@index([isActive])
  @@map("bank_rules")
}

model Attachment {
  id           String   @id @default(uuid())
  entityType   String   @map("entity_type") // invoice | expense | journal_entry | bank_transaction | bill
  entityId     String   @map("entity_id")
  fileName     String   @map("file_name")
  storagePath  String   @map("storage_path") // relative to upload root
  mimeType     String   @default("") @map("mime_type")
  sizeBytes    Int      @default(0) @map("size_bytes")
  uploadedById String?  @map("uploaded_by_id")
  isArchived   Boolean  @default(false) @map("is_archived")
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@map("attachments")
}

// ---------- REPORTS ----------

model FavoriteReport {
  id        String   @id @default(uuid())
  reportKey String   @unique @map("report_key")
  createdAt DateTime @default(now())

  @@map("favorite_reports")
}

// ---------- FILES ----------
// A virtual file manager. Folders are DB-only (a tree via parentId); file bytes
// live on disk under random names in a flat upload dir, so the client never
// controls a filesystem path.

model Folder {
  id          String       @id @default(uuid())
  name        String
  parentId    String?      @map("parent_id")
  parent      Folder?      @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Folder[]     @relation("FolderTree")
  files       StoredFile[]
  createdById String?      @map("created_by_id")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([parentId])
  @@map("folders")
}

model StoredFile {
  id           String   @id @default(uuid())
  name         String
  folderId     String?  @map("folder_id")
  folder       Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  storagePath  String   @map("storage_path") // relative to upload root; generated, never client-supplied
  mimeType     String   @default("") @map("mime_type")
  sizeBytes    Int      @default(0) @map("size_bytes")
  uploadedById String?  @map("uploaded_by_id")
  // When a file is a receipt filed from the Receipts inbox, this links it back to
  // the draft/real Expense it belongs to. Null for ordinary uploads.
  expenseId    String?  @map("expense_id")
  expense      Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([folderId])
  @@index([expenseId])
  @@map("stored_files")
}

// ============================================================================
// Wave 3 — Tax modules (T5, T4A, CCA, filing exports)
// Every *StoredFileId below is a plain String? resolved by id in app code —
// intentionally NO StoredFile relation (avoids editing the shared StoredFile
// model and the "missing opposite relation" prisma generate failure).
// ============================================================================

model TaxParty {
  id             String   @id @default(uuid())
  kind           String // individual | business
  firstName      String   @default("") @map("first_name")
  lastName       String   @default("") @map("last_name")
  businessName   String   @default("") @map("business_name")
  sinCipher      String?   @map("sin_cipher") // AES-GCM blob (iv:tag:ct), NEVER plaintext
  sinLast3       String?   @map("sin_last3") // for display masking only
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date // nullable; drives T1 age amount + is a WARNING (not hard block) when age amount is $0
  businessNumber String?   @map("business_number")
  addressLine1   String   @default("") @map("address_line_1")
  addressLine2   String   @default("") @map("address_line_2")
  city           String   @default("")
  province       String   @default("")
  postalCode     String   @default("") @map("postal_code")
  country        String   @default("CA")
  email          String   @default("")
  phone          String   @default("")
  clientId       String?  @map("client_id")
  client         Client?  @relation(fields: [clientId], references: [id])
  vendorId       String?  @map("vendor_id")
  vendor         Vendor?  @relation(fields: [vendorId], references: [id])
  isArchived     Boolean  @default(false) @map("is_archived") // blocked if non-draft slips exist
  slips          TaxSlip[]
  t1Returns      T1Return[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([vendorId])
  @@index([clientId])
  @@map("tax_parties")
}

model TaxSlip {
  id         String @id @default(uuid())
  type       String // T5 | T4A
  taxYear    Int    @map("tax_year")
  status     String @default("draft") // draft | issued | filed | amended | cancelled
  reportCode String @default("O") @map("report_code") // O | A | C

  partyId String   @map("party_id")
  party   TaxParty @relation(fields: [partyId], references: [id])

  recipientNameSnapshot    String  @map("recipient_name_snapshot")
  recipientSinCipher       String? @map("recipient_sin_cipher") // AES-GCM, frozen at issue
  recipientBnSnapshot      String? @map("recipient_bn_snapshot")
  recipientAddressSnapshot String  @default("") @map("recipient_address_snapshot")

  boxes         Json
  boxesOverride Json?  @map("boxes_override")
  currency      String @default("CAD")

  slipNumber   String? @map("slip_number") // allocated at draft->issued, non-null once issued
  amendmentSeq Int     @default(0) @map("amendment_seq")
  isCancelled  Boolean @default(false) @map("is_cancelled")

  amendsId  String?   @map("amends_id")
  amends    TaxSlip?  @relation("SlipAmendment", fields: [amendsId], references: [id])
  amendedBy TaxSlip[] @relation("SlipAmendment")

  summaryId String?         @map("summary_id") // back-link only (set at file time)
  summary   TaxSlipSummary? @relation(fields: [summaryId], references: [id])

  sourceRef        Json?     @map("source_ref")
  pdfStoredFileId  String?   @map("pdf_stored_file_id") // plain id, NO relation
  issuedAt         DateTime? @map("issued_at")
  filedAt          DateTime? @map("filed_at")
  craSubmissionRef String?   @map("cra_submission_ref")
  notes            String    @default("")
  createdById      String?   @map("created_by_id")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([type, taxYear, slipNumber, amendmentSeq])
  @@index([type, taxYear])
  @@index([partyId])
  @@index([status])
  @@index([amendsId])
  @@map("tax_slips")
}

model TaxSlipSummary {
  id                     String    @id @default(uuid())
  type                   String
  taxYear                Int       @map("tax_year")
  totals                 Json // FROZEN at file time; never read as live source of truth
  totalRecipients        Int       @default(0) @map("total_recipients")
  filerLegalNameSnapshot String    @default("") @map("filer_legal_name_snapshot")
  filerBnRzSnapshot      String    @default("") @map("filer_bn_rz_snapshot")
  filerAddressSnapshot   String    @default("") @map("filer_address_snapshot")
  status                 String    @default("filed") // a row exists only once filed
  filedAt                DateTime  @map("filed_at")
  craSubmissionRef       String?   @map("cra_submission_ref")
  pdfStoredFileId        String?   @map("pdf_stored_file_id") // plain id
  xmlStoredFileId        String?   @map("xml_stored_file_id") // plain id
  slips                  TaxSlip[]
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([type, taxYear])
  @@map("tax_slip_summaries")
}

model CcaClass {
